{
  "agent": {
    "instanceId": "auto",
    "strictMode": false
  },
  "service": {
    "name": "levitec-automation-telemetry",
    "namespace": "levitec",
    "version": "1.0.0",
    "environment": "production"
  },
  "signoz": {
    "endpoint": "http://signoz01.internal:4317",
    "protocol": "grpc",
    "timeoutSeconds": 10,
    "useTls": false,
    "headers": null
  },
  "buffer": {
    "enabled": true,
    "path": "C:\\ProgramData\\Levitec\\AutomationTelemetry\\buffer",
    "maxSizeMb": 500,
    "maxEventAgeHours": 72,
    "flushIntervalSeconds": 30,
    "batchSize": 50,
    "maxAttempts": 10,
    "deadLetterEnabled": true,
    "deadLetterPath": "C:\\ProgramData\\Levitec\\AutomationTelemetry\\dead-letter"
  }
}
